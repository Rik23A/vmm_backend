# ── Database ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/vmm_db

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters
JWT_EXPIRES_IN=7d

# ── App ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://vmm.yourdomain.com

# ── Tenant Mode ───────────────────────────────────────────────────────
# MULTI = SaaS (many companies on one server) — tenantId from JWT
# SINGLE = Enterprise (one company on their server) — tenantId from DEFAULT_TENANT_ID
TENANT_MODE=MULTI
DEFAULT_TENANT_ID=mycompany

# ── File Uploads & External Storage ───────────────────────────────────
# External directory where uploaded files are stored (outside backend code directory)
# Default if omitted: ../uploads (i.e. vmm-app/uploads)
# Can be set to a relative path or absolute path (e.g., /var/vmm_storage/uploads, D:/vmm_uploads)
UPLOADS_DIR=../uploads
# MAX file size in bytes (10MB = 10485760, 5MB = 5242880)
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# ── Email ─────────────────────────────────────────────────────────────
# Option A: cPanel / Company SMTP
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=vmm@yourdomain.com
EMAIL_PASS=your-email-password
EMAIL_FROM=VMM System <vmm@yourdomain.com>

# Option B: Gmail App Password (uncomment and fill)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ── SAP (Default / Fallback) ──────────────────────────────────────────
# Each tenant can override these via Admin > Settings in the UI
# SAP_VERSION: STUB | ECC | S4HANA
SAP_VERSION=STUB
SAP_HOST=192.168.1.100
SAP_CLIENT=100
SAP_SYSTEM_ID=PRD
SAP_USER=RFC_VMM
SAP_PASSWORD=your-sap-rfc-password
# S4HANA OData base URL (used when SAP_VERSION=S4HANA)
SAP_ODATA_URL=https://your-s4hana.com/sap/opu/odata/sap/API_BUSINESS_PARTNER
SAP_BP_GROUPING=ZV01
SAP_VENDOR_ROLE_FI=FLVN00
SAP_VENDOR_ROLE_PURCHASING=FLVN01
SAP_TAX_TYPE_PAN=IN3
SAP_TAX_TYPE_GST=IN03
